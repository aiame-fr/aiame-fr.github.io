#!/bin/sh
# Garde pre-push local, hors ligne, cout Actions ZERO -- GitHub Actions est
# desactive ORG-WIDE (facturation) depuis le 2026-08-27. Mirroir du motif
# deja prouve le 2026-07-30 sur 5 depots (aiame-memory:
# reference-gates-locaux-zero-cout), etendu a tout l'org cette fois puisque
# la panne est org-wide cette fois, pas cinq depots.
#
# NON ACTIF sur un clone/worktree frais -- core.hooksPath n'est pas versionne :
#   git config core.hooksPath .githooks
# Verifier : `git config core.hooksPath` (vide = garde inactif, votre push
# n'est verifie par rien ci-dessous).
#
# Trois issues, jamais deux : VERT (passe), ABSTENTION (outillage absent,
# signale, jamais presente comme un vert), ECHEC (bloque le push). Piege
# connu (memoire ci-dessus) : `S="$(cmd)"; c=$?` MEURT sous `set -e` a
# l'affectation si cmd sort non-nul -- capturer avec `&&`/`||` a la place.
#
# Ne mirroite PAS la CI complete (juste ce que garde-fous.yml faisait) --
# la suite complete reste le role de la CI quand la facturation revient. Ne
# PAS supprimer .github/workflows/garde-fous.yml : inerte, cout nul, reste
# la specification a laquelle revenir.
set -u

fail=0

run_check() {
  label="$1"; shift
  OUT="$("$@" 2>&1)" && rc=0 || rc=$?
  echo "$OUT" | tail -20
  if [ "$rc" -ne 0 ]; then
    echo "✗ $label ECHEC"
    fail=1
  else
    echo "✓ $label vert"
  fi
}
echo "== la copie du script est intacte =="
run_check "CANONICAL.sha256" sha256sum -c scripts/CANONICAL.sha256

echo "== la galaxie publiee est extraite, pas retouchee =="
# galaxie/index.html est genere dans aiame-workspace (galaxie.py --publier) ; sa somme vit
# dans galaxie/PROVENANCE.json. Retouche a la main -> rouge. Peremption : --verifier-publie cote workspace.
galaxie_intacte() {
  attendu="$(python3 -c 'import json;print(json.load(open("galaxie/PROVENANCE.json"))["sha256_index_html"])')" || return 1
  echo "$attendu  galaxie/index.html" | sha256sum -c -
}
run_check "galaxie PROVENANCE sha256" galaxie_intacte

echo "== la galaxie IA publiee est extraite, pas retouchee =="
# galaxie-ia/index.html est genere dans aiame-workspace (galaxie_ia.py --publier) ; sa somme, sa source et la date du releve vivent dans
# galaxie-ia/PROVENANCE.json. Retouche a la main, provenance qui ment, page sans provenance -> rouge. Prouve par test_verifier_galaxie_ia.sh.
# Peremption (la copie diffère de la page regeneree) : galaxie_ia.py --verifier-publie cote workspace.
run_check "verifier_galaxie_ia" bash scripts/verifier_galaxie_ia.sh
run_check "test_verifier_galaxie_ia" bash scripts/test_verifier_galaxie_ia.sh

echo "== l'accueil, quand il est la galaxie, est declare dans PROVENANCE et a sa somme =="
# 2026-10-10 : #64 a republie /galaxie/ sans --accueil ; l'accueil servi est reste une version en arriere sans qu'un garde le voie.
# Prouve par test_verifier_accueil_galaxie.sh (accueil perime, non declare, PROVENANCE absente).
run_check "verifier_accueil_galaxie" bash scripts/verifier_accueil_galaxie.sh
run_check "test_verifier_accueil_galaxie" bash scripts/test_verifier_accueil_galaxie.sh

echo "== aucune page publiee ne lie un depot PRIVE de l'organisation =="
# 2026-10-15 : 10 liens sur 4 pages (404 pour le public, et ils confirment que le depot existe). Prouve par
# test_verifier_liens_prives.sh (lien prive en FR/EN, www/http, .json, nom voisin d'un depot public).
run_check "verifier_liens_prives" bash scripts/verifier_liens_prives.sh
run_check "test_verifier_liens_prives" bash scripts/test_verifier_liens_prives.sh

echo "== la page Aiame Red n'est pas presentee comme une offre (FR, EN, portfolio) =="
# Aiame Red n'a tourne que sur nos propres produits, rien n'a ete vendu : la page ne doit proposer ni commande ni delai.
# Le garde est prouve par test_verifier_vitrine.sh (il fabrique chaque violation et exige que le garde la voie).
run_check "verifier_vitrine" bash scripts/verifier_vitrine.sh .
run_check "test_verifier_vitrine" bash scripts/test_verifier_vitrine.sh

echo "== aucune page ne defile a l'horizontale sur telephone, aucun mot ne sort de sa carte =="
# Mesure dans un vrai Chromium (360/390/768/1280 px) ; Playwright ou Chromium absent => code 2 = ABSTENTION (signalee, jamais un vert).
# Prouve par test_debordement.sh : il retire chaque correctif sur une copie et exige que le garde nomme la page.
for cmd in "python3 scripts/debordement.py" "bash scripts/test_debordement.sh"; do
  OUT="$($cmd 2>&1)"; rc=$?
  echo "$OUT" | tail -3
  case "$rc" in
    0) echo "✓ $cmd vert" ;;
    2) echo "⚠ $cmd ABSTENTION -- navigateur absent sur cette machine" ;;
    *) echo "✗ $cmd ECHEC (code $rc)"; fail=1 ;;
  esac
done

echo "== preuve que le garde sait echouer =="
run_check "test_garde_fous" bash scripts/test_garde_fous.sh

echo "== GF-1/2/3/4 sur tout le depot =="
run_check "garde_fous.sh" bash scripts/garde_fous.sh .

echo ""
if [ "$fail" -ne 0 ]; then
  echo "✗ pre-push : au moins un controle a echoue -- push bloque"
  exit 1
fi
echo "✅ pre-push au vert"
exit 0
